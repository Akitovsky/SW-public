<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'praises-window-title'}"
               MinSize="200 200"
               Resizable="False">
    <BoxContainer Orientation="Vertical">
        <RichTextLabel Name="InfoLabel" Text="{Loc 'praises-view-info'}"/>
        <ScrollContainer VScrollEnabled="True" HScrollEnabled="False">
            <BoxContainer Name="RecordContainer" Orientation="Vertical"/>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
