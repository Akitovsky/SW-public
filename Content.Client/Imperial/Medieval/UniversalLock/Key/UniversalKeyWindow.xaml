<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Imperial.Medieval.UniversalLock.Lock.UniversalKeyWindow"
               Title="Кузница: Настройка ключа"
               MinWidth="370"
               MinHeight="320">

    <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="10">

        <Label Name="InfoLabel" Text="Допустимые значения зубца: от 0 до 100" HorizontalAlignment="Center"/>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10" Margin="5">
            <Label Name="LengthLabel" Text="Количество зубцов:" MinWidth="130"/>
            <Slider Name="LengthSlider" MinValue="1" MaxValue="10" Rounded="True" HorizontalExpand="True"/>
            <LineEdit Name="LengthInput" MinWidth="45" MaxWidth="45" Text="1" HorizontalAlignment="Center"/>
        </BoxContainer>

        <ScrollContainer VerticalExpand="True" MinHeight="150" HorizontalExpand="True">
            <BoxContainer Name="InputsContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" Margin="5"/>
        </ScrollContainer>

        <Button Name="SetCodeButton" Text="Выковать ключ" HorizontalAlignment="Center"/>

    </BoxContainer>

</DefaultWindow>
